# RazorGuard AI - Environment Configuration

# Backend Configuration
PROJECT_NAME="RazorGuard AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL / SQLite fallback)
POSTGRES_USER=razorguard
POSTGRES_PASSWORD=razorguard_secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=razorguard_db
# Set DATABASE_URL directly if using SQLite for local quick start:
DATABASE_URL="sqlite:///./razorguard.db"

# LLM Provider Configuration
LLM_PROVIDER="offline_template" # options: "openai", "gemini", "groq", "offline_template"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
